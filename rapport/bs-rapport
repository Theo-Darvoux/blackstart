def fmt_pct(x):
    return f"{x:.1f}".replace(".", ",")


def fmt_s(s):
    if s is None:
        return "—"
    s = float(s)
    return f"{s:.0f} s" if s < 120 else f"{int(s // 60)} min {int(s % 60):02d} s"


def fmt_date(d):
    """« 2026-11-03 15:49 » → « 3 nov. à 15:49 »."""
    m = re.match(r"(\d{4})-(\d\d)-(\d\d)[ T](\d\d:\d\d)", d or "")
    return f"{int(m.group(3))} {MOIS[int(m.group(2)) - 1]} à {m.group(4)}" if m else (d or "")


def s_(n, mot):
    return f"{n} {mot}{'s' if n > 1 else ''}"


def bloc_verdict(v):
    cls, lib = verdict(v)
    p = (v["forge"] or {}).get("preuve") if v["forge"] and "erreur" not in v["forge"] else None
    out = [f'<div class="card"><h2 class="lbl">verdict</h2><div class="verdict {cls}">{esc(lib)}</div>']
    if p:
        ver = p["verif"]
        tm, cmp_ = ver["test_metier"], ver["comparaison"]["summary"]
        sv = ver.get("sauvegarde")
        items = [(True, "Machine reconstruite sur une VM neuve, isolée du réseau"),
                 (True, f'Test métier vert : {" · ".join(e["etape"].lower() for e in tm["etapes"])}'),
                 (True, f'Aucun écart non justifié avec l\'original ({cmp_["differences"]} écarts, tous expliqués)')]
        if sv:
            items.insert(1, (not sv.get("trop_vieux"), f'Données restaurées depuis la sauvegarde existante'
                             f'{" (sauvegarde en retard)" if sv.get("trop_vieux") else ""}'))
        out.append('<ul class="checks">' + "".join(
            f'<li><span class="{"ok" if ok else "ko"}">{"✓" if ok else "✗"}</span><span>{esc(t)}</span></li>' for ok, t in items) + '</ul>')
    elif cls == "echec":
        out.append('<p>La reconstruction n\'est pas lancée tant qu\'un humain n\'a pas tranché chaque élément inconnu.</p>')
    else:
        out.append('<p>Machine auditée, pas encore reconstruite : les risques ci-contre ne sont pas encore vérifiés.</p>')
    out.append('</div>')
    return "".join(out)


