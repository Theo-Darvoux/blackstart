def fmt_pct(x):
    return f"{x:.1f}".replace(".", ",")


def fmt_s(s):
    if s is None:
        return "—"
    s = float(s)
    return f"{s:.0f} s" if s < 120 else f"{int(s // 60)} min {int(s % 60):02d} s"


def render_vm(v):
    s, f = v["score"], v["forge"] or {}
    cls, lib = preuve(v)
    ver = f.get("verif") or {}
    ch = ver.get("chronos") or {}
    out = [f'<section class="vm" id="{esc(v["vm"])}">',
           f'<div class="vm-head"><div><h2>{esc(v["vm"])}</h2><div class="note">{esc(v["role"])}</div></div>'
           f'<div><span class="ip">{esc(v["ip"])}</span> <span class="pill {cls}">{lib}</span></div></div>',
           '<div class="grid">']
    # Points à risque, puis couverture du code (détail)
    r = risques(v)
    rl = "".join(f'<div><i class="dot"></i><span>{esc(lib_)}</span><b>{n}</b></div>' for lib_, n in r["parts"])
    out.append(f'<div><h3>Points à risque trouvés à l\'audit</h3><div class="score"><span class="big">{r["total"]}</span>'
               f'<span class="of num">{r["attente"]} en attente de décision · {r["acceptes"]} risque{"s" if r["acceptes"] > 1 else ""} '
               f'accepté{"s" if r["acceptes"] > 1 else ""}</span></div><div class="legend">{rl}</div>'
               '<p class="note">Ce que l\'audit a trouvé et qu\'une reprise doit traiter : décider, sauvegarder, ou savoir quoi changer si une adresse change. Détail plus bas.</p>')
    segs = "".join(f'<span style="width:{100.0 * n / s["total"]:.3f}%;background:var(--s-{k})" title="{esc(LIBELLES[k])} : {n}"></span>'
                   for k, n in s["comptes"].items() if n and s["total"])
    leg = "".join(f'<div><i style="background:var(--s-{k})"></i><span>{esc(LIBELLES[k])}</span><b>{n}</b></div>'
                  for k, n in s["comptes"].items())
    non_prouve = "" if cls == "prouvee" else ", <b>non prouvé</b>"
    audit = (f'<p class="note">À l\'audit, avant décision : <b class="num">{fmt_pct(s["pct_audit"])} %</b>, '
             f'{s["inconnus_audit"]} élément(s) inconnu(s) bloquaient la reconstruction.</p>'
             if s["inconnus_audit"] else '<p class="note">À l\'audit : aucun élément inconnu.</p>')
    out.append(f'<h3 class="sub">Couverture du code</h3><div class="score"><span class="mid">{fmt_pct(s["pct"])} %</span>'
               f'<span class="of num">{s["traites"]} éléments traités sur {s["total"]}{non_prouve}</span></div>'
               f'<div class="bar" role="img" aria-label="Répartition des {s["total"]} éléments par statut">{segs}</div>'
               f'<div class="legend">{leg}</div>{audit}'
               f'<p class="note">{s["ignores"]} éléments ignorés par règle (journaux, caches, identité de la machine) '
               'ne sont pas comptés.</p></div>')
    # Preuve
    blk = ['<div><h3>Preuve par reconstruction</h3>']
    if not f or "erreur" in f:
        blk.append('<p>Aucune merge request de reconstruction pour cette machine. Les chiffres ci-contre viennent de l\'audit seul : '
                   'ils n\'ont pas encore été vérifiés en reconstruisant la machine.</p>' if not f else
                   f'<p>Forge injoignable : {esc(f["erreur"])}</p>')
    else:
        blk.append(f'<p><a href="{esc(f["url"])}">Merge request n° {f["numero"]}</a> ({f["etat"]}), commit '
                   f'<code>{esc(f["sha"])}</code>, CI : <b>{esc(f["ci"])}</b>.</p>')
        if ch.get("total_s"):
            tot = sum(ch.get(k) or 0 for k, _ in ETAPES) or ch["total_s"]
            bars = "".join(f'<span style="flex:{ch[k]} 0 0" title="{esc(n)} : {ch[k]} s"></span>' for k, n in ETAPES if ch.get(k))
            legs = "".join(f'<span><span>{esc(n)}</span><span class="num">{ch[k]} s</span></span>' for k, n in ETAPES if ch.get(k) is not None)
            blk.append(f'<div class="score"><span class="big">{fmt_s(ch["total_s"])}</span><span class="of">de la VM vide '
                       'au service vérifié, en sandbox isolée</span></div>'
                       f'<div class="timeline" role="img" aria-label="Durée de chaque étape, {tot} s au total">{bars}</div>'
                       f'<div class="tl-legend">{legs}</div>')
        tm = ver.get("test_metier")
        if tm:
            items = "".join(f'<li><span class="{"ok" if e["ok"] else "ko"}">{"✓" if e["ok"] else "✗"}</span>'
                            f'<span><b>{esc(e["etape"])}</b> : {esc(e["detail"])}</span></li>' for e in tm["etapes"])
            blk.append(f'<p class="note">Test métier sur la copie isolée : {"vert" if tm["ok"] else "ROUGE"} en '
                       f'{fmt_pct(tm["duree_s"])} s.</p><ul class="checks">{items}</ul>')
        c = ver.get("comparaison")
        if c:
            sm = c["summary"]
            blk.append(f'<p class="note">Comparaison avec l\'original : {sm["differences"]} écarts, '
                       f'<b>{sm["unjustified"]} non justifiés</b>, {sm["justified"]} justifiés par règle ou décision.</p>')
        if ver.get("echec"):
            blk.append(f'<p class="note">Arrêt à l\'étape : {esc(ver["echec"]["etape_en_echec"])}</p>')
        if f.get("verif_date"):
            blk.append(f'<p class="note">Rapport de CI du {esc(f["verif_date"])}, heure de la forge ({esc(f.get("verif_source", ""))}).</p>')
    blk.append('</div>')
    out += blk
    out.append('</div>')
    # Bascules
    if v["bascules"]:
        rows = "".join(f'<tr><td class="num">{esc(b["date"])}</td><td class="num">{fmt_s(b["coupure_s"])}</td>'
                       f'<td>{"vert" if b["test_ok"] else "ROUGE"}</td><td>{"oui" if b.get("geste_manuel") else "non"}</td>'
                       f'<td><code>{esc(b["fichier"])}</code></td></tr>' for b in v["bascules"])
        out.append('<div class="grid"><div><h3>Bascule en production (répétition)</h3>'
                   '<p class="note">Coupure mesurée de l\'arrêt de l\'original jusqu\'au test métier complet vert '
                   '(proxy, DNS, mail réel).</p><div class="tbl"><table><thead><tr><th>Date</th><th>Coupure</th>'
                   f'<th>Test métier</th><th>Geste manuel</th><th>Mesure</th></tr></thead><tbody>{rows}</tbody></table></div></div></div>')
    # Décisions, attentes, trous
    side = []
    if s["attente"]:
        items = "".join(f'<li><code>{esc(e["key"])}</code> : {esc(e["raison"])}</li>' for e in s["attente"])
        side.append(f'<div><h3>En attente d\'une décision humaine</h3><ul class="plain">{items}</ul></div>')
    if v["decisions"]:
        rows = "".join(f'<tr><td><code>{esc(k)}</code></td><td class="dec {esc(d["decision"].split()[0])}">{esc(d["decision"])}</td>'
                       f'<td>{esc(d.get("par", "?"))}</td><td>{esc(d.get("raison", ""))}</td></tr>'
                       for k, d in sorted(v["decisions"].items()))
        side.append('<div><h3>Décisions prises</h3><div class="tbl"><table><thead><tr><th>Élément</th><th>Décision</th>'
                    f'<th>Par</th><th>Raison</th></tr></thead><tbody>{rows}</tbody></table></div></div>')
    acc = [f'<code>{esc(k)}</code> : {esc(d.get("raison", ""))}' for k, d in s["accepte"]]
    trous = [re.sub(r"`([^`]+)`", lambda m: f"<code>{esc(m.group(1))}</code>", esc(t).replace("&#x27;", "'")) for t in v["trous"]]
    if acc or trous:
        txt = ""
        if trous:
            txt += '<p class="note">Trous de la sauvegarde d\'origine, comblés par la restauration générée :</p><ul>' + \
                   "".join(f"<li>{t}</li>" for t in trous) + "</ul>"
        if acc:
            txt += '<p class="note">Risques acceptés, avec une action à mener :</p><ul>' + \
                   "".join(f"<li>{r}</li>" for r in acc) + "</ul>"
        side.append(f'<div class="warnbox"><h3>Ce que la sauvegarde ne couvrait pas</h3>{txt}</div>')
    if v["ip_en_dur"]:
        rows = "".join(f'<tr><td><code>{esc(h["path"])}</code></td><td class="num">{h["line"]}</td><td class="mono">{esc(h["ip"])}</td></tr>'
                       for h in v["ip_en_dur"])
        side.append('<div><h3>Dépendances écrites en dur</h3><p class="note">Adresses d\'autres machines dans la '
                    'configuration : à changer si une machine change d\'adresse.</p><div class="tbl"><table><thead><tr>'
                    f'<th>Fichier</th><th>Ligne</th><th>IP</th></tr></thead><tbody>{rows}</tbody></table></div></div>')
    if side:
        out.append('<div class="grid">' + "".join(side) + '</div>')
    out.append('</section>')
    return "\n".join(out)


def render(cfg, vms, fragment):
    date = time.strftime("%d/%m/%Y à %H:%M")
    rows = []
    for v in vms:
        cls, lib = preuve(v)
        f = v["forge"] or {}
        ch = ((f.get("verif") or {}).get("chronos") or {})
        bas = v["bascules"][-1]["coupure_s"] if v["bascules"] else None
        r = risques(v)
        rows.append(f'<tr><td><a href="#{esc(v["vm"])}"><b>{esc(v["vm"])}</b></a><div class="note">{esc(v["role"])}</div></td>'
                    f'<td><span class="pill {cls}">{lib}</span></td>'
                    f'<td class="num">{fmt_s(ch.get("total_s"))}<div class="note">{"reconstruction" if ch.get("total_s") else "pas encore mesurée"}</div></td>'
                    f'<td class="num">{fmt_s(bas)}<div class="note">{"coupure à la bascule" if bas is not None else "pas de bascule"}</div></td>'
                    f'<td class="num"><b>{r["total"]}</b> trouvé{"s" if r["total"] > 1 else ""}<div class="note">{r["attente"]} en attente · {r["acceptes"]} accepté{"s" if r["acceptes"] > 1 else ""}</div></td>'
                    f'<td>{f"<a href=\"{esc(f["url"])}\">n° {f["numero"]}</a>" if f.get("url") else "—"}</td></tr>')
    body = f"""<div class="wrap">
<header><div class="eyebrow">Black Start · rapport de reprise · généré le {date}</div>
<h1>{esc(cfg["entreprise"])}</h1>
<p class="lead">Chaque machine est auditée en lecture seule, puis reconstruite depuis le code et la sauvegarde dans une sandbox isolée.
Une reconstruction n'est dite prouvée que si le service répond, que le test métier passe et qu'aucun écart avec l'original ne reste sans justification.</p></header>
<div class="synth"><table><thead><tr><th>Machine</th><th>Verdict</th><th colspan="2">Reprise mesurée</th><th>Points à risque</th><th>Merge request</th></tr></thead>
<tbody>{"".join(rows)}</tbody></table></div>
{"".join(render_vm(v) for v in vms)}
<footer><p>Points à risque : éléments inconnus (décision humaine obligatoire), trous de la sauvegarde d'origine et adresses
d'autres machines écrites en dur, trouvés par l'audit. Couverture du code : part des éléments, hors éléments ignorés par règle,
dont la reprise est codée (Ansible, données restaurées, secrets au coffre) ou tranchée par un humain ; tous les éléments pèsent pareil.</p>
<p>Sources : inventaires de <code>bs-collect</code>, classement <code>bs-classify</code>, décisions du dépôt <code>{esc(cfg["depot"])}</code>,
rapports de la CI de <a href="{esc(cfg["forge"])}">la forge</a>, mesures de <code>infra/bascule.py</code>. Aucune valeur n'est estimée.</p></footer>
</div>"""
    head = f'<title>Rapport de reprise</title>\n<meta name="claude:viewport-fit-sides" content="cover">\n{FONTS}\n<style>{CSS}</style>\n'
    if fragment:
        return head + body + "\n"
    return ('<!doctype html>\n<html lang="fr"><head><meta charset="utf-8">'
            '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n'
            + head + '</head><body>\n' + body + '\n</body></html>\n')


def main():
    ap = argparse.ArgumentParser(description="Page de rapport de reprise, à partir des résultats réels.")
    ap.add_argument("--config", default=os.path.join(HERE, "vms.json"))
    ap.add_argument("--sortie", default=os.path.join(HERE, "sortie", "index.html"))
    ap.add_argument("--fragment", action="store_true", help="sans <html>/<head>/<body> (publication en artifact)")
    ap.add_argument("--hors-ligne", action="store_true", help="ne pas interroger la forge")
    ap.add_argument("--json", help="écrire aussi les données collectées dans ce fichier")
    args = ap.parse_args()
    cfg = load(args.config)
    vms = collect(cfg, args.hors_ligne)
    os.makedirs(os.path.dirname(os.path.abspath(args.sortie)), exist_ok=True)
    open(args.sortie, "w", encoding="utf-8").write(render(cfg, vms, args.fragment))
    if args.json:
        json.dump(vms, open(args.json, "w", encoding="utf-8"), ensure_ascii=False, indent=2, default=str)
    for v in vms:
        print(f"{v['vm']:15} {fmt_pct(v['score']['pct']):>6} %  {preuve(v)[1]}")
    print(f"page écrite : {args.sortie}")


if __name__ == "__main__":
    main()
