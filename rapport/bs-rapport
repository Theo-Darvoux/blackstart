#!/usr/bin/env python3
"""bs-rapport : page de rapport de reprise, construite uniquement à partir des
résultats réels (classement, décisions humaines, vérification CI, bascule).

    rapport/bs-rapport [--config rapport/vms.json] [--sortie rapport/sortie/index.html]
                       [--fragment] [--hors-ligne]

Sources, par VM :
  - classement   : sortie JSON de classement/bs-classify (chemin dans vms.json)
  - décisions    : decisions/<vm>.json et <vm>/DECISIONS.md de la copie du dépôt client
  - vérification : commentaires de la CI sur les merge requests reconstruction/<vm>
                   (bloc <!-- bs-verif … --> écrit par infra/ci-rapport.py ; sinon lecture
                   du texte du rapport)
  - bascule      : banc/resultats/bascule-*.json écrits par infra/bascule.py

La page suit la diapo « Le livrable » de l'oral (refaite le 4 novembre 2026) : pour la première
machine de vms.json, quatre blocs, puis une ligne par machine du parc.
  verdict : « Reconstruction prouvée » si une vérification de la CI a reconstruit la VM en sandbox,
            passé le test métier et trouvé 0 écart non justifié ; « Bloquée » s'il reste des
            inconnus sans décision ; sinon « non prouvée ». Preuve retenue : la dernière verte
            partie d'une VM vide ; une vérification plus récente qui n'est pas verte est signalée.
  chrono  : durée de la VM vide au service vérifié, en 4 étapes ; coupure de la dernière bascule.
  risques : inconnus + trous de la sauvegarde d'origine + IP d'autres machines écrites en dur,
            avec ce qui en a été fait.
  preuve  : merge request, commit et date de la vérification.
Rien n'est estimé : une valeur absente est affichée comme absente.
"""

import argparse
import glob
import html
import json
import os
import re
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.join(HERE, "..")
sys.path.insert(0, os.path.join(ROOT, "infra"))

LIBELLES = {
    "compris": "reproduit par le code",
    "donnee": "donnée restaurée",
    "secret": "secret au coffre",
    "tranche": "tranché par un humain",
    "attente": "décision en attente",
}
ETAPES = [("sandbox_s", "sandbox neuve"), ("reconstruction_s", "reconstruction"), ("restauration_s", "restauration"),
          ("redemarrage_s", "redémarrage"), ("test_metier_s", "test métier"), ("collecte_s", "collecte"),
          ("comparaison_s", "comparaison")]


def load(path):
    try:
        return json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return None


def esc(x):
    return html.escape(str(x), quote=True)


# --- Données -----------------------------------------------------------------

def score(classement, decisions):
    c = {k: 0 for k in LIBELLES}
    attente, accepte = [], []
    for e in classement["elements"]:
        st, d = e["statut"], decisions.get(e["key"])
        if st == "ignore":
            continue
        if d:
            c["tranche"] += 1
            if d["decision"] == "accepter":
                accepte.append((e["key"], d))
        elif st == "inconnu":
            c["attente"] += 1
            attente.append(e)
        else:
            c[st] += 1
    total = sum(c.values())
    # Même calcul sans les décisions humaines : l'état tel que l'audit l'a trouvé.
    audit = 100.0 * (total - c["tranche"] - c["attente"] + sum(
        1 for e in classement["elements"] if e["statut"] not in ("ignore", "inconnu") and e["key"] in decisions)) / total if total else 0.0
    return {"comptes": c, "pct_audit": audit, "inconnus_audit": classement["comptes"].get("inconnu", 0), "total": total, "ignores": classement["comptes"].get("ignore", 0),
            "traites": total - c["attente"], "pct": 100.0 * (total - c["attente"]) / total if total else 0.0,
            "attente": attente, "accepte": accepte}


def section_md(path, titre):
    try:
        txt = open(path, encoding="utf-8").read()
    except OSError:
        return []
    m = re.search(r"^## " + re.escape(titre) + r".*?\n(.*?)(?=^## |\Z)", txt, re.S | re.M)
    return [l[2:] for l in (m.group(1).splitlines() if m else []) if l.startswith("- ")]


def parse_verif(body):
    m = re.search(r"<!-- bs-verif (\{.*\}) -->", body, re.S)
    if m:
        try:
            return json.loads(m.group(1)), "bloc JSON de la CI"
        except ValueError:
            pass
    # Rapports antérieurs au bloc JSON : lecture du texte produit par ci-rapport.py.
    v = {"chronos": {}, "test_metier": None, "echec": None, "comparaison": None}
    m = re.search(r"Sandbox `([^`]+)` \(([\d.]+)\), parcours complet en \*\*(\d+) s\*\* \(([^)]*)\)", body)
    if m:
        v["chronos"] = {"sandbox": m.group(1), "ip": m.group(2), "total_s": int(m.group(3))}
        noms = {lib: k for k, lib in ETAPES}
        noms["sandbox"] = "sandbox_s"
        for nom, sec in re.findall(r"([a-zé ]+?) (\d+) s", m.group(4)):
            if nom.strip() in noms:
                v["chronos"][noms[nom.strip()]] = int(sec)
    m = re.search(r"\*\*Test métier\*\* : (\w+) en ([\d.]+) s", body)
    if m:
        etapes = [{"ok": ok == "✅", "etape": e, "detail": d}
                  for ok, e, d in re.findall(r"^- (✅|❌) ([^:]+?) : (.*)$", body, re.M)]
        v["test_metier"] = {"ok": m.group(1) == "vert", "duree_s": float(m.group(2)), "etapes": etapes}
    m = re.search(r"\*\*Comparaison avec l'original\*\* : (\d+) écarts, (\d+) non justifiés, (\d+) justifiés", body)
    if m:
        v["comparaison"] = {"summary": {"differences": int(m.group(1)), "unjustified": int(m.group(2)),
                                        "justified": int(m.group(3))},
                            "bloquants": re.findall(r"^\| `([^`]+)` \|", body, re.M)}
    m = re.search(r"Vérification interrompue : (.*)", body)
    if m:
        v["echec"] = {"etape_en_echec": m.group(1).strip()}
    return v, "texte du rapport de la CI"


def verte(ver):
    """Vérification de la CI qui prouve la reconstruction : test métier vert, 0 écart non justifié."""
    tm, cmp_ = ver.get("test_metier") or {}, (ver.get("comparaison") or {}).get("summary", {})
    return bool(not ver.get("echec") and tm.get("ok") and cmp_.get("unjustified") == 0
                and (ver.get("chronos") or {}).get("total_s"))


def forge_state(cfg, vm):
    """Merge requests de reconstruction de la VM : la dernière vérification, et la dernière preuve verte.

    La preuve retenue est la dernière vérification verte faite depuis une VM vide (sandbox créée pendant
    la CI) ; à défaut, la dernière vérification verte. Une vérification plus récente qui n'est pas verte
    (par exemple une MR qui attend des décisions) est signalée à côté, jamais cachée."""
    from forge import Forge
    f = Forge()
    branche = f"reconstruction/{vm}"
    prs = sorted((p for p in f.call("GET", f"/repos/{cfg['depot']}/pulls?state=all&limit=50")
                  if branche in (p["head"]["ref"], p["head"].get("label"))), key=lambda p: p["number"])
    if not prs:
        return None
    verifs = []
    for pr in prs:
        for c in f.call("GET", f"/repos/{cfg['depot']}/issues/{pr['number']}/comments"):
            if "bs-verif" in c["body"] or "parcours complet en" in c["body"]:
                ver, src = parse_verif(c["body"])
                verifs.append({"numero": pr["number"], "url": pr["html_url"], "sha": pr["head"]["sha"][:7],
                               "etat": "fusionnée" if pr["merged"] else ("ouverte" if pr["state"] == "open" else "fermée"),
                               "date": c["created_at"][:16].replace("T", " "), "verif": ver, "verif_source": src})
    verifs.sort(key=lambda v: v["date"])
    vertes = [v for v in verifs if verte(v["verif"])]
    completes = [v for v in vertes if (v["verif"]["chronos"].get("sandbox_s") or 0) > 0]
    preuve_ = (completes or vertes or [None])[-1]
    derniere = verifs[-1] if verifs else None
    if derniere is None:
        pr = prs[-1]
        derniere = {"numero": pr["number"], "url": pr["html_url"], "sha": pr["head"]["sha"][:7], "date": None,
                    "etat": "ouverte" if pr["state"] == "open" else "fermée", "verif": {}}
    return {"preuve": preuve_, "derniere": derniere}


def bascules(vm):
    out = []
    for p in sorted(glob.glob(os.path.join(ROOT, "banc", "resultats", "bascule-*.json"))):
        d = load(p)
        if d and d.get("bascule"):
            out.append({**d["bascule"], "test_ok": d.get("ok"), "fichier": os.path.relpath(p, ROOT)})
    return out if vm == "bs-logistique" else []


def collect(cfg, hors_ligne):
    vms = []
    for v in cfg["vms"]:
        cl = load(os.path.join(ROOT, v["classement"]))
        if not cl:
            sys.exit(f"classement introuvable : {v['classement']}")
        dec = load(os.path.join(ROOT, cfg["copie_depot"], "decisions", f"{v['vm']}.json")) or {}
        md = os.path.join(ROOT, cfg["copie_depot"], v["vm"], "DECISIONS.md")
        f = None
        if not hors_ligne:
            try:
                f = forge_state(cfg, v["vm"])
            except Exception as exc:  # forge injoignable : on le dit, on n'invente rien
                f = {"erreur": str(exc)}
        vms.append({**v, "score": score(cl, dec), "decisions": dec, "ip_en_dur": cl.get("ip_en_dur", []),
                    "trous": section_md(md, "Trous de la sauvegarde"), "forge": f, "bascules": bascules(v["vm"])})
    return vms


def risques(v):
    """Ce que la reprise doit traiter, trouvé à l'audit, avec ce qui en a été fait."""
    s, prouvee = v["score"], verdict(v)[0] == "prouvee"
    trous = len(v["trous"]) + sum(1 for k, _ in s["accepte"] if k.startswith("data:"))
    acc = sum(1 for k, _ in s["accepte"] if k.startswith("data:"))
    n_inc, att = s["inconnus_audit"], s["comptes"]["attente"]
    if not n_inc:
        st_inc = "aucun"
    elif prouvee:
        st_inc = "tranchés par l'admin"
    else:
        st_inc = f"{att} en attente de décision" if att else "tranchés par l'admin"
    st_trous = ("comblés par la restauration générée" + (f", dont {acc} risque{'s' if acc > 1 else ''} accepté{'s' if acc > 1 else ''}" if acc else "")) if trous else "aucun"
    parts = [("éléments inconnus", n_inc, st_inc),
             ("trous dans la sauvegarde", trous, st_trous),
             ("adresses IP écrites en dur", len(v["ip_en_dur"]), "à changer si une machine change d'adresse" if v["ip_en_dur"] else "aucune")]
    return {"parts": parts, "total": sum(n for _, n, _ in parts)}


def verdict(v):
    f = v["forge"]
    if not f:
        return "absente", "Pas encore reconstruite"
    if "erreur" in f:
        return "absente", "Forge injoignable"
    if f["preuve"]:
        return "prouvee", "Reconstruction prouvée"
    n = max(v["score"]["comptes"]["attente"], len(f["derniere"]["verif"].get("attente") or []))
    if n:
        return "echec", f"Bloquée : {n} décision{'s' if n > 1 else ''} en attente"
    return "echec", "Reconstruction non prouvée"


def suivi(v):
    """Vérification plus récente que la preuve et pas verte : on le dit."""
    f = v["forge"] or {}
    p, d = f.get("preuve"), f.get("derniere")
    if not p or not d or d is p or not d.get("date") or d["date"] <= p["date"]:
        return ""
    n = len(d["verif"].get("attente") or [])
    quoi = f"attend {n} décision{'s' if n > 1 else ''}" if n else "n'est pas encore verte"
    return f'Depuis, la <a href="{esc(d["url"])}">merge request n° {d["numero"]}</a> {quoi}.'


