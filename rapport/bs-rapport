        cs = [x["coupure_s"] for x in v["bascules"]]
        out.append(f'<div class="coupure"><b>{fmt_s(b["coupure_s"])}</b><span>de coupure à la bascule en production'
                   f'{", sans geste manuel" if not b.get("geste_manuel") else ""}</span></div>'
                   f'<p class="note">Dernière de {len(cs)} répétitions, de {fmt_s(min(cs))} à {fmt_s(max(cs))}.</p>')
    out.append('</div>')
    return "".join(out)


def bloc_risques(v):
    r = risques(v)
    rows = "".join(f'<div><b>{n}</b><span>{esc(lib)}<small>{esc(st)}</small></span></div>' for lib, n, st in r["parts"])
    return (f'<div class="card"><h2 class="lbl">risques</h2><div class="big">{r["total"]}<small>points que la reprise doit traiter</small></div>'
            f'<div class="risk">{rows}</div></div>')


def bloc_preuve(v):
    f = v["forge"]
    out = ['<div class="card"><h2 class="lbl">preuve</h2>']
    if not f:
        out.append('<p>Aucune merge request de reconstruction pour cette machine.</p>')
    elif "erreur" in f:
        out.append(f'<p>Forge injoignable : {esc(f["erreur"])}</p>')
    else:
        p = f["preuve"] or f["derniere"]
        ci = "verte" if f["preuve"] else "rouge"
        out.append(f'<div class="big mr"><a href="{esc(p["url"])}">Merge request n° {p["numero"]}</a><small>CI {ci}</small></div>'
                   '<ul class="checks"><li><span class="ok">✓</span><span>Code de la machine (Ansible) proposé en merge request, relu par l\'admin</span></li>'
                   f'<li><span class="{"ok" if f["preuve"] else "ko"}">{"✓" if f["preuve"] else "✗"}</span><span>Vérifié par la CI'
                   f'{" le " + fmt_date(p["date"]) if p.get("date") else ""}</span></li>'
                   '<li><span class="ok">✓</span><span>Bascule en production refusée tant que la CI n\'est pas verte</span></li></ul>')
        sv = (p.get("verif") or {}).get("sauvegarde")
        if sv:
            out.append(f'<p class="note">Données de l\'instantané restic du {fmt_date(sv["date"])}, âgé de {fmt_pct(sv["age_h"])} h : '
                       'c\'est ce qui serait perdu en basculant à cet instant.</p>')
        t = suivi(v)
        if t:
            out.append(f'<p class="note">{t}</p>')
    out.append('</div>')
    return "".join(out)


def ligne_parc(v):
    cls, lib = verdict(v)
    f = v["forge"] if v["forge"] and "erreur" not in v["forge"] else {}
    p = f.get("preuve")
    r = risques(v)
    mr = f'<a href="{esc(p["url"])}">MR n° {p["numero"]}</a>' if p else "—"
    return (f'<tr><td><b>{esc(v["vm"])}</b><small>{esc(v["role"])}</small></td><td><span class="pill {cls}">{esc(lib)}</span></td>'
            f'<td class="num">{fmt_s(p["verif"]["chronos"]["total_s"]) if p else "—"}</td>'
            f'<td class="num">{s_(r["total"], "point")}</td><td>{mr}</td></tr>')


def render(cfg, vms, fragment):
    date = time.strftime("%d/%m/%Y à %H:%M")
    v = vms[0]
    body = f"""<div class="wrap">
<header><div class="eyebrow">Black Start · rapport de reprise · {esc(cfg["entreprise"])} · généré le {date}</div>
<h1>{esc(v["vm"])} : {esc(v["role"][:1].lower() + v["role"][1:])}</h1>
<p class="lead">Peut-on redémarrer cette machine, et en combien de temps ? Réponse mesurée en la reconstruisant, pas estimée.</p></header>
<div class="cards">{bloc_verdict(v)}{bloc_chrono(v)}{bloc_risques(v)}{bloc_preuve(v)}</div>
<div class="parc"><table><thead><tr><th>Parc</th><th>Verdict</th><th>Chrono</th><th>Risques</th><th>Preuve</th></tr></thead>
<tbody>{"".join(ligne_parc(x) for x in vms)}</tbody></table></div>
<footer>Sources : collecte en lecture seule (<code>bs-collect</code>), classement (<code>bs-classify</code>), rapports de la CI
de <a href="{esc(cfg["forge"])}">la forge</a>, mesures de bascule (<code>infra/bascule.py</code>). Aucune valeur n'est estimée.</footer>
</div>"""
    head = f'<title>Rapport de reprise</title>\n<meta name="claude:viewport-fit-sides" content="cover">\n{FONTS}\n<style>{CSS}</style>\n'
    if fragment:
        return head + body + "\n"
    return ('<!doctype html>\n<html lang="fr"><head><meta charset="utf-8">'
            '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n'
            + head + '</head><body>\n' + body + '\n</body></html>\n')


def main():
    ap = argparse.ArgumentParser(description="Page de rapport de reprise, à partir des résultats réels.")
    ap.add_argument("--config", default=os.path.join(HERE, "vms.json"))
    ap.add_argument("--sortie", default=os.path.join(HERE, "sortie", "index.html"))
    ap.add_argument("--fragment", action="store_true", help="sans <html>/<head>/<body> (publication en artifact)")
    ap.add_argument("--hors-ligne", action="store_true", help="ne pas interroger la forge")
    ap.add_argument("--json", help="écrire aussi les données collectées dans ce fichier")
    args = ap.parse_args()
    cfg = load(args.config)
    vms = collect(cfg, args.hors_ligne)
    os.makedirs(os.path.dirname(os.path.abspath(args.sortie)), exist_ok=True)
    open(args.sortie, "w", encoding="utf-8").write(render(cfg, vms, args.fragment))
    if args.json:
        json.dump(vms, open(args.json, "w", encoding="utf-8"), ensure_ascii=False, indent=2, default=str)
    for v in vms:
        print(f"{v['vm']:15} {verdict(v)[1]}")
    print(f"page écrite : {args.sortie}")


if __name__ == "__main__":
    main()
